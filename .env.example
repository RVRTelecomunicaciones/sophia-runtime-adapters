# .env.example — Phase 2C.4 / A+B real receiver credentials.
#
# Convention: TEST tenant credentials carry NO 'PROD_' prefix or
# infix. Production credentials use a 'PROD_' prefix or infix
# (e.g., PAGERDUTY_PROD_ROUTING_KEY) and are NEVER loaded into CI
# (CI guardrail Layer 2 rejects any env var matching ^(PROD_|.*_PROD_|.*_PRODUCTION_)).
#
# Copy this file to .env (gitignored) and fill in test-tenant
# values. See docs/test-tenant.md (ships in B3) for setup.
#
# Values flow: .env → operator's shell → `make secrets-write` →
# .secrets/<name> file → Docker Compose secret mount → Alertmanager
# *_file directives. Alertmanager does NOT read these env vars
# directly (it does not support $VAR substitution natively per
# A2C4AB.4); the indirection through .secrets/ is what makes
# `amtool check-config` validate clean and is the official
# documented pattern since Alertmanager v0.25.0.
#
# All values below are EMPTY by default. Alertmanager will fail
# fast at startup if a referenced credential is empty (e.g., a
# 0-length routing_key is rejected by PagerDuty Events API v2).

# ---- B1 — Alertmanager native receivers ---------------------------------

# PagerDuty Events API v2 — routing key for the test service
# (PagerDuty UI → Service → Integrations → Events API v2). The
# routing key is per-service, not per-account. The test service
# has NO escalation policy → pages NEVER wake a human.
PAGERDUTY_TEST_ROUTING_KEY=

# Slack incoming webhook for #incidents (test workspace).
# Format: https://hooks.slack.com/services/T.../B.../...
SLACK_TEST_INCIDENTS_WEBHOOK_URL=

# Slack incoming webhook for #ops (test workspace).
SLACK_TEST_OPS_WEBHOOK_URL=

# ---- B2 — Linear webhook adapter ----------------------------------------

# Linear API token with write access on the test team
# (Linear Settings → API → Personal API Keys). Test tenant only.
LINEAR_TEST_API_TOKEN=

# Linear team ID (UUID-shaped) for the test workspace.
# Get via the GraphQL query `{ teams { nodes { id name } } }`.
LINEAR_TEST_TEAM_ID=

# Linear API URL — defaults to https://api.linear.app/graphql.
# Override only for adapter integration tests (httptest stub).
LINEAR_API_URL=

# Linear tenant type fingerprint — must equal "test" when CI=true
# or the adapter aborts at startup (Layer 4 — D2C4AB.16, spec §7.8).
LINEAR_TENANT_TYPE=test

# Anti-spam interval for re-firing comments (D2C4AB.9). Default 15m.
# Format: Go duration (e.g., "5m", "1h", "30s").
LINEAR_RECOMMENT_MIN_INTERVAL=15m

# Listen address for the linear-webhook-adapter HTTP server.
# Default :9095 — see ops/local/compose.yaml.
LISTEN_ADDR=:9095

# Bootstrap mode lock (Layer 3). Required when CI=true; must equal
# "test" or both runtime-adapters and linear-webhook-adapter abort
# at startup (D2C4AB.16, spec §9.3).
RUNTIME_TENANT=test

# ---- B3 — Smoke target -------------------------------------------------

# PagerDuty Incidents API token (read + write on incidents). Test
# tenant only. Used by ops/smoke/smoke-receivers.sh to verify the
# critical incident landed and to resolve it during cleanup.
PAGERDUTY_TEST_API_TOKEN=

# PagerDuty service ID for the test service (NOT the routing key —
# the routing key is in B1's PAGERDUTY_TEST_ROUTING_KEY). Used as
# a query filter to scope incident lookups to the test service.
PAGERDUTY_TEST_SERVICE_ID=

# Slack bot user OAuth token (xoxb-...) with scopes channels:history
# + chat:write, scoped to the test channels only. Test workspace
# only. Used by smoke for verification + cleanup.
SLACK_TEST_BOT_TOKEN=

# Slack channel IDs for #alerts-test-incidents and #alerts-test-ops
# (or operator's chosen names). Get via Slack UI → channel details.
SLACK_TEST_INCIDENTS_CHANNEL_ID=
SLACK_TEST_OPS_CHANNEL_ID=
