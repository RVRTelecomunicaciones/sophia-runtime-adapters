{
  "uid": "runtime-overview",
  "title": "Runtime Adapters — Overview",
  "tags": ["runtime-adapters", "2c.1"],
  "schemaVersion": 39,
  "editable": false,
  "timezone": "",
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "description": "Oncall entry point. Consolidated view across shell / git / filesystem / http adapters. No $capability dropdown — drill into a per-adapter dashboard to filter.",
  "links": [
    {
      "title": "runtime-shell",
      "type": "dashboards",
      "tags": ["runtime-adapters", "2c.1"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Shell drill-down",
      "type": "link",
      "url": "/d/runtime-shell?${__url_time_range}",
      "asDropdown": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Git drill-down",
      "type": "link",
      "url": "/d/runtime-git?${__url_time_range}",
      "asDropdown": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Filesystem drill-down",
      "type": "link",
      "url": "/d/runtime-fs?${__url_time_range}",
      "asDropdown": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "HTTP drill-down",
      "type": "link",
      "url": "/d/runtime-http?${__url_time_range}",
      "asDropdown": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "prom"},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "stat",
      "title": "shell.exec@v1 — budget 30d",
      "description": "Sloth period_error_budget_remaining for shell-exec-availability. Click the title to drill into runtime-shell with capability preselected.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "orange", "value": 0.1},
            {"color": "green", "value": 0.5}
          ]},
          "links": [
            {"title": "runtime-shell", "url": "/d/runtime-shell?var-capability=shell.exec%40v1&${__url_time_range}", "targetBlank": false}
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"},
         "expr": "slo:period_error_budget_remaining:ratio{sloth_slo=\"shell-exec-availability\"}",
         "legendFormat": "shell.exec@v1"}
      ]
    },
