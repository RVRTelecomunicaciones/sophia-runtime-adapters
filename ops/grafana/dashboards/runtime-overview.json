      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Burn rate matrix (1h / 6h, availability SLOs)",
      "description": "Per-capability current burn rate across 1h and 6h windows. >1 means the budget for the window is exhausted. Row click → data link into the adapter dashboard.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 1},
            {"color": "red", "value": 6}
          ]},
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}}
        },
        "overrides": []
      },
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max by (sloth_slo, capability) (slo:sli_error:ratio_rate1h / on(sloth_id, sloth_slo, sloth_service) group_left slo:error_budget:ratio)",
          "legendFormat": "{{sloth_slo}}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max by (sloth_slo, capability) (slo:sli_error:ratio_rate6h / on(sloth_id, sloth_slo, sloth_service) group_left slo:error_budget:ratio)",
          "legendFormat": "{{sloth_slo}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Traffic by adapter",
      "description": "rate(execution_total) per adapter, stacked area (1h window refresh).",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"stacking": {"mode": "normal"}}},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum by (adapter) (rate(runtime_adapters_execution_total[$__rate_interval]))",
          "legendFormat": "{{adapter}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Pool acquire p95",
      "description": "pgx pool acquire latency p95 (5m). Saturation indicator.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 1},
            {"color": "red", "value": 5}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"},
         "expr": "histogram_quantile(0.95, sum by (le) (rate(runtime_adapters_pool_connections_acquired_duration_seconds_bucket[$__rate_interval])))",
         "legendFormat": "pool p95"}
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "OTel queue %",
      "description": "otel.exporter.queue.size divided by the 10000-item default queue (§8 infra_otel).",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 0.5},
            {"color": "red", "value": 0.9}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"},
         "expr": "max(runtime_adapters_otel_exporter_queue_size) / 10000",
         "legendFormat": "queue %"}
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Receipt persist fails (rate 5m)",
      "description": "rate(receipt.persist.failures). A4.3 — persistence-before-return means failures here are real caller-visible failures.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 0.01},
            {"color": "red", "value": 0.1}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"},
         "expr": "sum(rate(runtime_adapters_receipt_persist_failures[$__rate_interval]))",
         "legendFormat": "persist fails/s"}
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Adapter panics (rate 5m)",
      "description": "rate(adapter.panics) — R4 guarantee, recovered panics still surface here.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 13},
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 0.001},
            {"color": "red", "value": 0.01}
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"},
         "expr": "sum by (adapter) (rate(runtime_adapters_adapter_panics[$__rate_interval]))",
         "legendFormat": "{{adapter}}"}
      ]
    },
    {
      "id": 40,
      "type": "alertlist",
      "title": "Firing alerts (critical + warning)",
      "description": "Alertmanager-backed list. Filtered by severity = critical | warning so info-tier alerts (concurrency rejects) are excluded.",
      "datasource": {"type": "alertmanager", "uid": "alertmanager"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 17},
      "fieldConfig": {
        "defaults": {"unit": "none"},
        "overrides": []
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 50,
        "sortOrder": 3,
        "dashboardAlerts": false,
        "alertName": "",
        "dashboardTitle": "",
        "alertInstanceLabelFilter": "severity=~\"critical|warning\"",
        "datasource": "alertmanager"
      }
    }
  ]
}
